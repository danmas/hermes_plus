{
  "name": "hermes_plus",
  "version": "0.4.0",
  "description": "UI-оболочка для Hermes Agent: fleet skills/sessions/config/чат через web-API дашборда",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/index.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@tanstack/react-query": "^5.59.0",
    "hono": "^4.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
