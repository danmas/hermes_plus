# ── hermes_plus prod-BFF (server/) ────────────────────────────────────────────
# Скопируйте в .env.local и заполните. .env.local НЕ коммитится.
# Секреты — только здесь; agents-config.json содержит лишь ${VAR}-плейсхолдеры.

# Логин оператора BFF (для browser password manager; не секрет).
# Рядом с паролем в .env.local — менеджеры сохраняют пару login+password.
HERMES_PLUS_USERNAME=operator

# ОБЯЗАТЕЛЬНО: пароль оператора BFF (≥ 24 символов, без него BFF не стартует).
# Генерация: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Если пароль начинается с # — обязательно в кавычках: HERMES_PLUS_PASSWORD="##secret"
HERMES_PLUS_PASSWORD=

# Порт BFF (8787 согласован; 3000–3002 заняты Kosmos Panel)
PORT=8787

# Secure-флаг сессионной куки: auto = по x-forwarded-proto (за reverse-proxy),
# 1 = всегда Secure (только HTTPS), 0 = никогда (локальный http)
COOKIE_SECURE=auto

# ── Upstream-агенты ───────────────────────────────────────────────────────────
# Локальный Hermes (профили projects-ex / default)
HERMES_LOCAL_ORIGIN=http://127.0.0.1:9119
# Стабильный session-token (если задан при старте Hermes) — иначе BFF сам
# парсит SESSION_TOKEN__ из SPA HTML
HERMES_DASHBOARD_SESSION_TOKEN=

# Локальный dashboard при auth_required:true (cookie login; нет SESSION_TOKEN__ в HTML)
# Те же креды, что для входа в hermes dashboard на :9119
HERMES_LOCAL_USERNAME=
HERMES_LOCAL_PASSWORD=

# LAN-агент l1 (192.168.1.221, cookie-auth)
HERMES_L1_ORIGIN=http://192.168.1.221:9119
HERMES_L1_USERNAME=
HERMES_L1_PASSWORD=

# ── Dev-режим Vite (старые переменные, используются vite.config.ts) ──────────
VITE_HERMES_L1_USERNAME=
VITE_HERMES_L1_PASSWORD=
